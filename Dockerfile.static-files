FROM nginx:alpine

# Serves per-team challenge zips for static/file-download challenges.
# Structure: challenges/static-content/{challenge_id}/{team_id}.zip
#
# Generated by: python3 scripts/generate-static-artifacts.py
# Flags are baked into the challenge files by the generator (no injection at serve time).
#
# The plugin's /download/{challenge_id} endpoint fetches:
#   http://static-files.ctfd.svc.cluster.local/{challenge_id}/{team_id}.zip
COPY challenges/static-content/ /usr/share/nginx/html/

RUN printf 'server {\n\
  listen 80;\n\
  server_name _;\n\
  root /usr/share/nginx/html;\n\
  location / {\n\
    autoindex off;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf
